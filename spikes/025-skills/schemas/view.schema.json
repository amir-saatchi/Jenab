{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burrow.local/schema/view.json",
  "title": "Burrow view config: table, chart or form (SPEC 5), SPIKE-021 draft",
  "type": "object",
  "required": ["version", "id", "title", "type"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "type": { "enum": ["table", "chart", "form"] }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "table" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/table" } },
    { "if": { "properties": { "type": { "const": "chart" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/chart" } },
    { "if": { "properties": { "type": { "const": "form" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/form" } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64 },
    "format": { "enum": ["text", "number", "currency", "percent", "date", "datetime", "url", "boolean", "image", "file"] },
    "scalar": { "type": ["string", "number", "boolean"] },
    "options": {
      "anyOf": [
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } },
        { "type": "object", "required": ["query"], "additionalProperties": false, "properties": { "query": { "type": "string", "minLength": 1 } } }
      ]
    },
    "filter": {
      "type": "object",
      "required": ["param", "control"],
      "additionalProperties": false,
      "properties": {
        "param": { "$ref": "#/$defs/name" },
        "control": { "enum": ["text", "number", "date", "select", "checkbox"] },
        "label": { "type": "string" },
        "default": { "$ref": "#/$defs/scalar" },
        "required": { "type": "boolean" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "action": {
      "type": "object",
      "required": ["label", "run_pipeline"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "run_pipeline": { "$ref": "#/$defs/id" }
      }
    },
    "table": {
      "type": "object",
      "required": ["query", "columns", "default_sort"],
      "additionalProperties": false,
      "properties": {
        "version": {}, "id": {}, "title": {}, "type": {},
        "description": { "type": "string", "maxLength": 1000 },
        "query": { "type": "string", "minLength": 1 },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/$defs/name" },
              "label": { "type": "string" },
              "format": { "$ref": "#/$defs/format" },
              "format_options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                  "decimals": { "type": "integer", "minimum": 0, "maximum": 10 }
                }
              },
              "align": { "enum": ["left", "center", "right"] }
            }
          }
        },
        "default_sort": {
          "type": "object",
          "required": ["field", "direction"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/name" },
            "direction": { "enum": ["asc", "desc"] }
          }
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows_from": {
          "type": "object",
          "required": ["table", "key"],
          "additionalProperties": false,
          "properties": {
            "table": { "$ref": "#/$defs/id" },
            "key": { "$ref": "#/$defs/name" }
          }
        },
        "row_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "open_form": { "$ref": "#/$defs/id" },
              "delete": { "const": true },
              "confirm": { "type": "boolean" }
            },
            "oneOf": [ { "required": ["open_form"] }, { "required": ["delete"] } ]
          }
        }
      }
    },
    "chart": {
      "type": "object",
      "required": ["query", "chart_type", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "version": {}, "id": {}, "title": {}, "type": {},
        "description": { "type": "string", "maxLength": 1000 },
        "query": { "type": "string", "minLength": 1 },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "chart_type": { "enum": ["line", "bar", "scatter"] },
        "x": {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/name" },
            "label": { "type": "string" },
            "format": { "$ref": "#/$defs/format" }
          }
        },
        "y": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/$defs/name" },
              "label": { "type": "string" }
            }
          }
        },
        "series_by": { "$ref": "#/$defs/name" }
      }
    },
    "form": {
      "type": "object",
      "required": ["fields", "submit"],
      "additionalProperties": false,
      "properties": {
        "version": {}, "id": {}, "title": {}, "type": {},
        "description": { "type": "string", "maxLength": 1000 },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "control"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/$defs/name" },
              "label": { "type": "string" },
              "control": { "enum": ["text", "textarea", "number", "date", "select", "checkbox", "file"] },
              "required": { "type": "boolean" },
              "default": { "$ref": "#/$defs/scalar" },
              "options": { "$ref": "#/$defs/options" },
              "prefix": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*/$" }
            }
          }
        },
        "submit": {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": {
            "action": { "enum": ["insert", "update", "run_pipeline"] },
            "table": { "$ref": "#/$defs/id" },
            "key": { "$ref": "#/$defs/name" },
            "pipeline": { "$ref": "#/$defs/id" }
          },
          "allOf": [
            { "if": { "properties": { "action": { "const": "insert" } }, "required": ["action"] }, "then": { "required": ["table"] } },
            { "if": { "properties": { "action": { "const": "update" } }, "required": ["action"] }, "then": { "required": ["table", "key"] } },
            { "if": { "properties": { "action": { "const": "run_pipeline" } }, "required": ["action"] }, "then": { "required": ["pipeline"] } }
          ]
        },
        "load": { "type": "string", "minLength": 1 }
      }
    }
  }
}
