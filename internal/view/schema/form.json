{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenab.local/schema/form.json",
  "title": "A form view (SPEC 5.5)",
  "$ref": "defs.json#/$defs/view",
  "required": ["fields", "submit"],
  "additionalProperties": false,
  "properties": {
    "version": {}, "id": {}, "title": {}, "description": {}, "actions": {},
    "type": { "const": "form" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "control"],
        "additionalProperties": false,
        "properties": {
          "field": { "$ref": "defs.json#/$defs/name" },
          "label": { "type": "string", "maxLength": 200 },
          "control": { "enum": ["text", "textarea", "number", "date", "select", "checkbox", "file"] },
          "required": { "type": "boolean" },
          "default": { "$ref": "defs.json#/$defs/scalar" },
          "options": { "$ref": "defs.json#/$defs/options" },
          "prefix": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "submit": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["insert", "update", "run_pipeline"] },
        "table": { "$ref": "defs.json#/$defs/name" },
        "key": { "$ref": "defs.json#/$defs/name" },
        "pipeline": { "$ref": "defs.json#/$defs/ref" }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "insert" } }, "required": ["action"] }, "then": { "required": ["table"] } },
        { "if": { "properties": { "action": { "const": "update" } }, "required": ["action"] }, "then": { "required": ["table", "key"] } },
        { "if": { "properties": { "action": { "const": "run_pipeline" } }, "required": ["action"] }, "then": { "required": ["pipeline"] } }
      ]
    },
    "load": { "type": "string", "minLength": 1 }
  }
}
