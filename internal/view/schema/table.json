{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenab.local/schema/table.json",
  "title": "A table view (SPEC 5.3)",
  "$ref": "defs.json#/$defs/queryView",
  "required": ["columns", "default_sort"],
  "additionalProperties": false,
  "properties": {
    "version": {}, "id": {}, "title": {}, "description": {}, "actions": {},
    "query": {}, "params": {}, "filters": {},
    "type": { "const": "table" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field"],
        "additionalProperties": false,
        "properties": {
          "field": { "$ref": "defs.json#/$defs/name" },
          "label": { "type": "string", "maxLength": 200 },
          "format": { "$ref": "defs.json#/$defs/format" },
          "format_options": { "$ref": "defs.json#/$defs/formatOptions" },
          "align": { "enum": ["start", "end", "left", "center", "right"] }
        }
      }
    },
    "default_sort": {
      "type": "object",
      "required": ["field", "direction"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "defs.json#/$defs/name" },
        "direction": { "enum": ["asc", "desc"] }
      }
    },
    "page_size": { "type": "integer", "minimum": 1, "maximum": 500 },
    "rows_from": {
      "type": "object",
      "required": ["table", "key"],
      "additionalProperties": false,
      "properties": {
        "table": { "$ref": "defs.json#/$defs/name" },
        "key": { "$ref": "defs.json#/$defs/name" }
      }
    },
    "row_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": { "$ref": "defs.json#/$defs/label" },
          "open_form": { "$ref": "defs.json#/$defs/ref" },
          "delete": { "const": true },
          "set": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          },
          "bulk": { "type": "boolean" },
          "confirm": { "type": "boolean" }
        }
      }
    }
  }
}
